# Copiez ce fichier en `supabase/functions/.env`, remplissez les valeurs, puis :
#   supabase secrets set --env-file supabase/functions/.env --project-ref gfpguuuzzyqoxjkhlhli
#
# NE COMMITTEZ JAMAIS le fichier `.env` rempli (il est ignoré par .gitignore).
# Marche à suivre détaillée : voir CHECKLIST_SANDBOX.md.

# --- Choix du prestataire ---------------------------------------------------
# 'mock'     : succès immédiat, aucun appel externe — pour tester le parcours
#              de bout en bout sans compte prestataire.
# 'cinetpay' : paiement réel / sandbox CinetPay (Orange Money, Moov Money, carte).
BILLING_PROVIDER=mock

# --- CinetPay (si BILLING_PROVIDER=cinetpay) -------------------------------
# API v1 CinetPay (authentification par jeton OAuth). Récupérez la Clé API
# dans votre tableau de bord (Intégrations → API) et générez-y aussi un Mot
# de passe API (champ « API password », vide par défaut). Pour les tests,
# utilisez les identifiants du service en mode "Test".
CINETPAY_API_KEY=SANDBOX_A_REMPLACER
CINETPAY_API_PASSWORD=SANDBOX_A_REMPLACER
# api.cinetpay.net = test/sandbox · api.cinetpay.co = production (l'environnement
# se choisit par le domaine, pas par un mode du service côté dashboard).
CINETPAY_BASE_URL=https://api.cinetpay.net

# --- URLs publiques -------------------------------------------------------
# Où renvoyer l'utilisateur après paiement (page de l'app).
APP_PUBLIC_URL=https://jurisia-app.pages.dev
# URL de notification serveur-à-serveur (Edge Function billing-webhook).
# À déclarer aussi comme « notify_url » côté CinetPay.
BILLING_NOTIFY_URL=https://gfpguuuzzyqoxjkhlhli.supabase.co/functions/v1/billing-webhook

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont injectés
# automatiquement par Supabase dans les Edge Functions — ne pas les mettre ici.
